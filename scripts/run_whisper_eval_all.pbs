#!/usr/bin/env bash
#PBS -S /bin/bash
#PBS -N STDIN
#PBS -q xvn_s
#PBS -l select=1:res=middle2
#PBS -l walltime=24:00:00
#PBS -j oe
#PBS -V

# Evaluate each CT2 Whisper model in manifest.txt against the same wavs and
# references. See README_whisper_batch_eval.md for the manifest format.
#
# Submit:
#   qsub scripts/run_whisper_eval_all.pbs

set -euo pipefail
cd "${PBS_O_WORKDIR:-$(pwd)}"

if [[ -f "$PWD/scripts/setup_proxy.sh" ]]; then
    # shellcheck source=/dev/null
    source "$PWD/scripts/setup_proxy.sh"
fi

CONFIG="${CONFIG:-configs/whisper_streaming_eval.yaml}"
SETTINGS_FILE="${SETTINGS_FILE:-manifest.txt}"
WAV_DIR="${WAV_DIR:-}"
REFS="${REFS:-}"
EVAL_MANIFEST="${EVAL_MANIFEST:-out/whisper_turbo/test_manifest.jsonl}"
OUT_DIR="${OUT_DIR:-experiments/whisper_turbo_eval_all}"
WHISPER_STREAMING_DIR="${WHISPER_STREAMING_DIR:-vendor/whisper_streaming}"
WHISPER_STREAMING_REF="${WHISPER_STREAMING_REF:-main}"
# xvn_s/res=middle2 provides four V100 GPUs. Up to one model is evaluated on
# each GPU concurrently; additional models wait for the next free batch.
GPU_LIST="${GPU_LIST:-0,1,2,3}"
export WHISPER_STREAMING_DIR

mkdir -p logs experiments/pbs_logs vendor "$(dirname "$EVAL_MANIFEST")" "$OUT_DIR"
JOB_ID_RAW="${PBS_JOBID:-local_$(date +%Y%m%d_%H%M%S)}"
JOB_TAG="${JOB_ID_RAW%%.*}"
JOB_LOG="experiments/pbs_logs/ws_turbo_eval_all_${JOB_TAG:-local}.log"
exec > >(tee -a "$JOB_LOG") 2>&1

echo "===== batch whisper streaming eval ====="
echo "settings:     $SETTINGS_FILE"
echo "out_dir:     $OUT_DIR"

command -v uv >/dev/null 2>&1 || { echo "ERROR: uv is not available on PATH." >&2; exit 1; }
[[ -s "$SETTINGS_FILE" ]] || { echo "ERROR: manifest is missing or empty: $SETTINGS_FILE" >&2; exit 1; }

manifest_value() {
    awk -v key="$1" 'index($0, key "=") == 1 { value = substr($0, length(key) + 2) } END { sub(/\r$/, "", value); print value }' "$SETTINGS_FILE"
}

[[ -n "$WAV_DIR" ]] || WAV_DIR="$(manifest_value WAV_DIR)"
[[ -n "$REFS" ]] || REFS="$(manifest_value REFS)"
MODELS_INPUT_FILE="$OUT_DIR/models_input.tsv"
MODELS_FILE="$OUT_DIR/models.tsv"
awk 'index($0, "MODEL=") == 1 { print substr($0, 7) }' "$SETTINGS_FILE" | sed 's/\r$//' > "$MODELS_INPUT_FILE"
: > "$MODELS_FILE"

echo "wav_dir:      ${WAV_DIR:-missing}"
echo "refs:         ${REFS:-missing}"
echo "eval_manifest: $EVAL_MANIFEST"
echo "models:       $(grep -c . "$MODELS_INPUT_FILE" || true)"
[[ -n "$REFS" && -s "$REFS" ]] || { echo "ERROR: REFS is required for a valid model comparison." >&2; exit 1; }
[[ -d "$WAV_DIR" ]] || { echo "ERROR: WAV_DIR does not exist: $WAV_DIR" >&2; exit 1; }
IFS=',' read -r -a GPU_IDS <<< "$GPU_LIST"
[[ "${#GPU_IDS[@]}" -gt 0 ]] || { echo "ERROR: GPU_LIST is empty." >&2; exit 1; }
echo "gpu_list:     $GPU_LIST (parallel batch size=${#GPU_IDS[@]})"
if command -v nvidia-smi >/dev/null 2>&1; then nvidia-smi; fi

export UV_HTTP_TIMEOUT="${UV_HTTP_TIMEOUT:-120}"
export HF_HUB_DOWNLOAD_TIMEOUT="${HF_HUB_DOWNLOAD_TIMEOUT:-60}"
uv sync -v

if [[ ! -d "$WHISPER_STREAMING_DIR/.git" ]]; then
    git clone https://github.com/ufal/whisper_streaming.git "$WHISPER_STREAMING_DIR"
fi
git -C "$WHISPER_STREAMING_DIR" fetch --depth 1 origin "$WHISPER_STREAMING_REF" || true
git -C "$WHISPER_STREAMING_DIR" checkout "$WHISPER_STREAMING_REF"

uv run python scripts/build_test_manifest.py \
    --wav-dir "$WAV_DIR" --references "$REFS" --out "$EVAL_MANIFEST"
test -s "$EVAL_MANIFEST"

write_status() {
    local result_dir="$1" status="$2" reason="$3"
    mkdir -p "$result_dir"
    printf 'status=%s\nreason=%s\n' "$status" "$reason" > "$result_dir/status.txt"
}

prepare_result_dir() {
    local result_dir="$1"
    mkdir -p "$result_dir"
    # Do not let an old successful run make a currently missing/failed model
    # appear as completed in this run's summary.
    rm -f "$result_dir/summary.json" "$result_dir/status.txt"
}

evaluate_model() {
    local label="$1" model_dir="$2" result_dir="$3" gpu_id="$4"
    echo "===== evaluating $label ($model_dir) on GPU $gpu_id ====="
    if CUDA_VISIBLE_DEVICES="$gpu_id" uv run python scripts/evaluate_whisper_streaming.py \
        --config "$CONFIG" \
        --model-dir "$model_dir" \
        --manifest "$EVAL_MANIFEST" \
        --out-dir "$result_dir"; then
        write_status "$result_dir" "completed" ""
    else
        write_status "$result_dir" "failed" "evaluate_whisper_streaming.py exited with a non-zero status"
        echo "WARN: evaluation failed for $label; continuing with the next model." >&2
    fi
}

wait_for_batch() {
    local pid
    for pid in "${PIDS[@]}"; do
        wait "$pid" || true
    done
    PIDS=()
}

declare -A SEEN_LABELS=()
model_index=0
evaluation_index=0
PIDS=()
while IFS=$'\t' read -r label model_dir extra || [[ -n "${label:-}" ]]; do
    [[ -z "${label// /}" || "$label" == \#* ]] && continue
    model_index=$((model_index + 1))
    if [[ -n "${extra:-}" || -z "${model_dir:-}" || ! "$label" =~ ^[A-Za-z0-9._-]+$ ]]; then
        safe_label="invalid_${model_index}"
        printf '%s\t%s\n' "$safe_label" "<invalid MODEL row>" >> "$MODELS_FILE"
        prepare_result_dir "$OUT_DIR/$safe_label"
        write_status "$OUT_DIR/$safe_label" "skipped" "invalid MODEL row; use label<TAB>CT2_model_dir"
        echo "WARN: skipped invalid MODEL row $model_index" >&2
        continue
    fi
    if [[ -n "${SEEN_LABELS[$label]:-}" ]]; then
        safe_label="${label}__duplicate_${model_index}"
        printf '%s\t%s\n' "$safe_label" "$model_dir" >> "$MODELS_FILE"
        prepare_result_dir "$OUT_DIR/$safe_label"
        write_status "$OUT_DIR/$safe_label" "skipped" "duplicate model label: $label"
        echo "WARN: skipped duplicate label: $label" >&2
        continue
    fi
    SEEN_LABELS[$label]=1
    printf '%s\t%s\n' "$label" "$model_dir" >> "$MODELS_FILE"
    result_dir="$OUT_DIR/$label"
    prepare_result_dir "$result_dir"
    if [[ ! -d "$model_dir" || ! -s "$model_dir/model.bin" ]]; then
        write_status "$result_dir" "skipped" "CT2 model not found or incomplete: $model_dir"
        echo "WARN: skipped $label; CT2 model not found or incomplete: $model_dir" >&2
        continue
    fi
    gpu_id="${GPU_IDS[$((evaluation_index % ${#GPU_IDS[@]}))]}"
    evaluation_index=$((evaluation_index + 1))
    evaluate_model "$label" "$model_dir" "$result_dir" "$gpu_id" &
    PIDS+=("$!")
    if [[ "${#PIDS[@]}" -ge "${#GPU_IDS[@]}" ]]; then
        echo "===== waiting for parallel evaluation batch (${#PIDS[@]} models) ====="
        wait_for_batch
    fi
done < "$MODELS_INPUT_FILE"

if [[ "${#PIDS[@]}" -gt 0 ]]; then
    echo "===== waiting for final parallel evaluation batch (${#PIDS[@]} models) ====="
    wait_for_batch
fi

[[ -s "$MODELS_FILE" ]] || { echo "WARN: no usable MODEL rows; writing an empty summary." >&2; }

uv run python scripts/summarize_whisper_evals.py \
    --models-file "$MODELS_FILE" --results-dir "$OUT_DIR"

echo "summary: $OUT_DIR/summary.md"
echo "finished_at: $(date -Iseconds)"
