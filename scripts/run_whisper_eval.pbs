#!/usr/bin/env bash
#PBS -S /bin/bash
#PBS -N ws_turbo_eval
#PBS -q xvn_s
#PBS -l select=1:res=small
#PBS -l walltime=04:00:00
#PBS -j oe
#PBS -V

# FT+CT2変換した whisper を whisper-streaming で評価する。res=small = V100×1。
# 対象は共有された test wav 群。参照テキストがあれば CER/WER も出す。
#
# Submit:
#   WAV_DIR=data/test_wav qsub -V scripts/run_whisper_eval.pbs
#   WAV_DIR=data/test_wav REFS=data/test_refs.tsv qsub -V scripts/run_whisper_eval.pbs
#   MODEL_DIR=out/whisper_turbo/ct2 MANIFEST=out/whisper_turbo/test_manifest.jsonl qsub -V scripts/run_whisper_eval.pbs

set -euo pipefail
cd "${PBS_O_WORKDIR:-$(pwd)}"

CONFIG="${CONFIG:-configs/whisper_streaming_eval.yaml}"
MODEL_DIR="${MODEL_DIR:-out/whisper_turbo/ct2}"
WAV_DIR="${WAV_DIR:-data/test_wav}"
REFS="${REFS:-}"
MANIFEST="${MANIFEST:-out/whisper_turbo/test_manifest.jsonl}"
OUT_DIR="${OUT_DIR:-experiments/whisper_turbo_eval}"
WHISPER_STREAMING_DIR="${WHISPER_STREAMING_DIR:-vendor/whisper_streaming}"
WHISPER_STREAMING_REF="${WHISPER_STREAMING_REF:-main}"
CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES:-0}"
export CUDA_VISIBLE_DEVICES

mkdir -p logs experiments/pbs_logs vendor "$(dirname "$MANIFEST")"
JOB_ID_RAW="${PBS_JOBID:-local_$(date +%Y%m%d_%H%M%S)}"
JOB_TAG="${JOB_ID_RAW%%.*}"
JOB_LOG="experiments/pbs_logs/ws_turbo_eval_${JOB_TAG:-local}.log"
exec > >(tee -a "$JOB_LOG") 2>&1

echo "===== whisper-turbo streaming eval ====="
echo "host:       $(hostname)"
echo "model_dir:  $MODEL_DIR"
echo "wav_dir:    $WAV_DIR"
echo "refs:       ${REFS:-none}"
echo "manifest:   $MANIFEST"
echo "out_dir:    $OUT_DIR"
echo "started_at: $(date -Iseconds)"
echo "========================================"

command -v uv >/dev/null 2>&1 || { echo "ERROR: uv is not available on PATH." >&2; exit 1; }
if command -v nvidia-smi >/dev/null 2>&1; then nvidia-smi; fi
if [[ ! -d "$MODEL_DIR" ]]; then
    echo "ERROR: CT2モデルが無い: $MODEL_DIR (先に run_whisper_train.pbs を実行)" >&2
    exit 1
fi

uv sync

if [[ ! -d "$WHISPER_STREAMING_DIR/.git" ]]; then
    git clone https://github.com/ufal/whisper_streaming.git "$WHISPER_STREAMING_DIR"
fi
git -C "$WHISPER_STREAMING_DIR" fetch --depth 1 origin "$WHISPER_STREAMING_REF" || true
git -C "$WHISPER_STREAMING_DIR" checkout "$WHISPER_STREAMING_REF"

# test manifest を組む (既存なら再利用しない: wav群が変わる可能性があるため毎回作る)
build_args=(uv run python scripts/build_test_manifest.py --wav-dir "$WAV_DIR" --out "$MANIFEST")
if [[ -n "$REFS" ]]; then build_args+=(--references "$REFS"); fi
"${build_args[@]}"
test -s "$MANIFEST"

uv run python scripts/evaluate_whisper_streaming.py \
    --config "$CONFIG" \
    --model-dir "$MODEL_DIR" \
    --manifest "$MANIFEST" \
    --out-dir "$OUT_DIR"

echo "report:      $OUT_DIR/report.md"
echo "predictions: $OUT_DIR/predictions.jsonl"
echo "finished_at: $(date -Iseconds)"
