#!/usr/bin/env bash
#PBS -S /bin/bash
#PBS -N STDIN
#PBS -q xvn_s
#PBS -l select=1:res=middle2
#PBS -l walltime=03:00:00
#PBS -j oe
#PBS -V

# End-to-end smoke test of the auto-research loop on the real hardware.
#
# It builds a tiny SYNTHETIC dataset, then runs the actual pipeline: LoRA
# fine-tune -> dev decode -> Gemma proposes the next config -> screening stage
# -> finalist re-run at full length -> holdout eval -> Gemma writes the report
# discussion -> merge + CT2 export.
#
# The audio is generated tones, not speech, so CER will be near 1.0. That is
# expected: this checks that every stage RUNS and writes its outputs, not that
# the model is good. Any stage that fails makes the job exit non-zero - there is
# no fallback that could hide a broken component.
#
# Submit:
#   qsub scripts/run_autoresearch_smoke.pbs
#   qsub -q xan_s -l select=1:res=middle -v NUM_GPUS=2 scripts/run_autoresearch_smoke.pbs
#   qsub -v OFFLINE=1 scripts/run_autoresearch_smoke.pbs
#   # skip the LLM parts (checks only train/eval/export):
#   qsub -v USE_GEMMA=0 scripts/run_autoresearch_smoke.pbs
#
# Runtime is dominated by loading whisper-large-v3-turbo and Gemma; budget ~1-2h.

set -euo pipefail
cd "${PBS_O_WORKDIR:-$(pwd)}"

OFFLINE="${OFFLINE:-0}"
if [[ "$OFFLINE" == "1" ]]; then
    echo "OFFLINE=1: using prestaged .venv and HF cache (no network access)"
    export UV_OFFLINE=1 HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1
else
    if [[ -f "$PWD/scripts/setup_proxy.sh" ]]; then
        # shellcheck source=/dev/null
        source "$PWD/scripts/setup_proxy.sh"
    fi
fi

SMOKE_DIR="${SMOKE_DIR:-out/smoke}"
WORK_DIR="${WORK_DIR:-$SMOKE_DIR/autoresearch}"
BASE_MODEL_FILE="${BASE_MODEL_FILE:-manifest.txt}"
TRAIN_UTTERANCES="${TRAIN_UTTERANCES:-12}"
TEST_UTTERANCES="${TEST_UTTERANCES:-8}"

NUM_GPUS="${NUM_GPUS:-1}"
if [[ -n "${GPU_LIST:-}" ]]; then
    CUDA_VISIBLE_DEVICES="$GPU_LIST"
else
    CUDA_VISIBLE_DEVICES="$(seq -s, 0 $((NUM_GPUS - 1)))"
fi
export CUDA_VISIBLE_DEVICES

# Small enough to finish quickly, large enough to exercise both stages:
# 2 screening trials (trial 0 = baseline, trial 1 = proposed by Gemma) and
# 1 finalist re-run at full length.
SCREEN_MINUTES="${SCREEN_MINUTES:-3}"
FINALISTS="${FINALISTS:-1}"
MAX_TRIALS="${MAX_TRIALS:-2}"
N_RANDOM="${N_RANDOM:-0}"
BUDGET_HOURS="${BUDGET_HOURS:-2}"
RESERVE_MINUTES="${RESERVE_MINUTES:-25}"
MAX_TRIAL_HOURS="${MAX_TRIAL_HOURS:-0.5}"
USE_GEMMA="${USE_GEMMA:-1}"
GEMMA_MODEL="${GEMMA_MODEL:-google/gemma-4-E4B-it}"
GEMMA_TIMEOUT_SEC="${GEMMA_TIMEOUT_SEC:-1200}"
EVAL_BATCH_SIZE="${EVAL_BATCH_SIZE:-4}"
EARLY_STOP_DEV_LIMIT="${EARLY_STOP_DEV_LIMIT:-4}"
FINAL_EXPORT="${FINAL_EXPORT:-1}"

mkdir -p logs experiments/pbs_logs "$SMOKE_DIR"
JOB_ID_RAW="${PBS_JOBID:-local_$(date +%Y%m%d_%H%M%S)}"
JOB_TAG="${JOB_ID_RAW%%.*}"
JOB_LOG="experiments/pbs_logs/ws_autoresearch_smoke_${JOB_TAG:-local}.log"
exec > >(tee -a "$JOB_LOG") 2>&1

echo "===== auto-research SMOKE TEST ====="
echo "host:        $(hostname)"
echo "smoke_dir:   $SMOKE_DIR"
echo "work_dir:    $WORK_DIR"
echo "gpus:        $CUDA_VISIBLE_DEVICES (num_gpus=$NUM_GPUS)"
echo "trials:      $MAX_TRIALS screening (${SCREEN_MINUTES}min each) + $FINALISTS finalist"
echo "gemma:       $USE_GEMMA ($GEMMA_MODEL)"
echo "started_at:  $(date -Iseconds)"
echo "NOTE: synthetic audio -> CER near 1.0 is expected. This checks wiring."
echo "===================================="

command -v uv >/dev/null 2>&1 || { echo "ERROR: uv is not available on PATH." >&2; exit 1; }
if command -v nvidia-smi >/dev/null 2>&1; then nvidia-smi; fi

if [[ "$OFFLINE" == "1" ]]; then
    uv sync --offline
else
    export UV_HTTP_TIMEOUT="${UV_HTTP_TIMEOUT:-120}"
    export HF_HUB_DOWNLOAD_TIMEOUT="${HF_HUB_DOWNLOAD_TIMEOUT:-60}"
    uv sync
fi

# Start from a clean slate so a previous smoke run cannot make this one pass.
rm -rf "$SMOKE_DIR"
mkdir -p "$SMOKE_DIR"

echo "===== step 1/3: build the dummy dataset ====="
uv run python scripts/make_smoke_data.py \
    --out-dir "$SMOKE_DIR" \
    --train "$TRAIN_UTTERANCES" \
    --test "$TEST_UTTERANCES"
test -s "$SMOKE_DIR/train_manifest.jsonl"
test -s "$SMOKE_DIR/refs.txt"

echo "===== step 2/3: build the evaluation manifest ====="
# make_smoke_data.py keeps the training audio in a separate directory, so every
# wav here has exactly one matching reference line.
uv run python scripts/build_test_manifest.py \
    --wav-dir "$SMOKE_DIR/wav" \
    --references "$SMOKE_DIR/refs.txt" \
    --out "$SMOKE_DIR/test_manifest.jsonl"
test -s "$SMOKE_DIR/test_manifest.jsonl"

echo "===== step 3/3: run the loop ====="
loop_args=(
    --train-manifest "$SMOKE_DIR/train_manifest.jsonl"
    --eval-manifest "$SMOKE_DIR/test_manifest.jsonl"
    --work-dir "$WORK_DIR"
    --base-model-file "$BASE_MODEL_FILE"
    --num-gpus "$NUM_GPUS"
    --eval-batch-size "$EVAL_BATCH_SIZE"
    --budget-hours "$BUDGET_HOURS"
    --reserve-minutes "$RESERVE_MINUTES"
    --max-trial-hours "$MAX_TRIAL_HOURS"
    --max-trials "$MAX_TRIALS"
    --screen-minutes "$SCREEN_MINUTES"
    --finalists "$FINALISTS"
    --n-random "$N_RANDOM"
    --elite-k 2
    --keep-adapters 2
    --early-stop-dev-limit "$EARLY_STOP_DEV_LIMIT"
    --gemma-model "$GEMMA_MODEL"
    --gemma-timeout-sec "$GEMMA_TIMEOUT_SEC"
    --gemma-proposals 2
)
[[ "$USE_GEMMA" == "0" ]] && loop_args+=(--no-gemma --no-analysis)
[[ "$FINAL_EXPORT" == "1" ]] && loop_args+=(--final-export)

loop_status=0
uv run python scripts/run_autoresearch.py "${loop_args[@]}" || loop_status=$?

echo "===== checking the outputs ====="
failures=0
check_file() {
    if [[ -s "$1" ]]; then
        echo "  OK    $2: $1"
    else
        echo "  FAIL  $2 is missing or empty: $1" >&2
        failures=$((failures + 1))
    fi
}
check_dir() {
    if [[ -d "$1" ]]; then
        echo "  OK    $2: $1"
    else
        echo "  FAIL  $2 is missing: $1" >&2
        failures=$((failures + 1))
    fi
}

check_file "$WORK_DIR/state/state.json" "search state"
check_file "$WORK_DIR/state/trials.jsonl" "trial log"
check_file "$WORK_DIR/report.md" "report"
check_file "$WORK_DIR/best_config.json" "best config"
check_file "$WORK_DIR/data/dev.jsonl" "dev split"
check_file "$WORK_DIR/data/holdout.jsonl" "holdout split"
check_file "$WORK_DIR/final/holdout_summary.json" "holdout evaluation"
if [[ "$USE_GEMMA" != "0" ]]; then
    check_file "$WORK_DIR/final/analysis_response.json" "Gemma-written discussion"
    if ls "$WORK_DIR"/proposals/response_*.json >/dev/null 2>&1; then
        echo "  OK    Gemma proposals: $(ls "$WORK_DIR"/proposals/response_*.json | wc -l) response file(s)"
    else
        echo "  FAIL  no Gemma proposal response in $WORK_DIR/proposals" >&2
        failures=$((failures + 1))
    fi
fi
if [[ "$FINAL_EXPORT" == "1" ]]; then
    check_dir "$WORK_DIR/final/merged_hf" "merged model"
    check_file "$WORK_DIR/final/ct2/model.bin" "CT2 model"
fi

# Both stages must have produced a completed trial, and the trials must carry
# real scores - an empty search that wrote its files is still a failure.
uv run python - "$WORK_DIR/state/state.json" <<'PY' || failures=$((failures + 1))
import json
import sys
from pathlib import Path

state = json.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))
trials = state.get("trials", [])
completed = [t for t in trials if t.get("status") == "completed" and t.get("score") is not None]
screened = [t for t in completed if t.get("stage") == "screen"]
full = [t for t in completed if t.get("stage") == "full"]
print(f"  trials={len(trials)} completed={len(completed)} screen={len(screened)} full={len(full)}")
for trial in trials:
    metrics = trial.get("metrics") or {}
    print(
        f"    trial {trial['index']} stage={trial.get('stage')} source={trial.get('source')} "
        f"status={trial['status']} score={trial.get('score')} cer={metrics.get('cer')} "
        f"steps={metrics.get('steps_completed')} error={(trial.get('error') or '')[:120]}"
    )
ok = True
if not screened:
    print("  FAIL  no completed screening trial", file=sys.stderr)
    ok = False
if not full:
    print("  FAIL  no completed full-length trial", file=sys.stderr)
    ok = False
sys.exit(0 if ok else 1)
PY

echo "===== result ====="
echo "loop exit status: $loop_status"
echo "output checks failed: $failures"
if [[ "$loop_status" != "0" || "$failures" != "0" ]]; then
    echo "SMOKE TEST FAILED - see $JOB_LOG and $WORK_DIR/trials/*/trial.log" >&2
    echo "finished_at: $(date -Iseconds)"
    exit 1
fi
echo "SMOKE TEST PASSED"
echo "report:      $WORK_DIR/report.md"
echo "finished_at: $(date -Iseconds)"
